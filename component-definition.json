          "id": "profile",
          "plugins": {
            "da": {
              "name": "profile",
              "rows": 1,
              "columns": 2
            }
          },
          "model": "profile",
          "filter": "profile"
        },
        {
          "title": "Profile",
          "id": "profile-item",
          "plugins": {
            "da": {
              "rows": 1,
              "columns": 2,
              "fields": [
                {
                  "name": "image",
                  "selector": "div:nth-child(1) picture>img[src]"
